{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated Administrator or Remote Device profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["ADMIN", "REMOTE_DEVICE", "SUPER_ADMIN"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Device": {
      "title": "Device",
      "description": "Android remote device enrolled into Smart Remote Connect Pro",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
        "model": { "type": "string", "maxLength": 80 },
        "androidVersion": { "type": "string", "maxLength": 30 },
        "isOnline": { "type": "boolean" },
        "batteryLevel": { "type": "number" },
        "isCharging": { "type": "boolean" },
        "chargingSource": { "type": "string", "enum": ["AC", "USB", "WIRELESS", "BATTERY"] },
        "batteryTemperature": { "type": "number" },
        "lastSeen": { "type": "string" },
        "pairedAt": { "type": "string" },
        "cameraFacing": { "type": "string", "enum": ["FRONT", "BACK"] },
        "isStreamingCamera": { "type": "boolean" },
        "isStreamingAudio": { "type": "boolean" },
        "activeSessionId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "adminId", "name", "model", "isOnline"]
    },
    "PairingRequest": {
      "title": "PairingRequest",
      "description": "One-time PIN and QR token pairing session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "pairingCode": { "type": "string", "maxLength": 8 },
        "adminId": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 256 },
        "adminName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "EXPIRED", "REVOKED"] },
        "pairedDeviceId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "number" }
      },
      "required": ["id", "pairingCode", "adminId", "status", "expiresAt"]
    },
    "StreamSession": {
      "title": "StreamSession",
      "description": "WebRTC live camera or audio stream session between Admin and Remote Device",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "adminId": { "type": "string", "maxLength": 128 },
        "adminName": { "type": "string", "maxLength": 100 },
        "streamType": { "type": "string", "enum": ["CAMERA", "AUDIO", "BOTH"] },
        "cameraFacing": { "type": "string", "enum": ["FRONT", "BACK"] },
        "status": { "type": "string", "enum": ["PENDING_APPROVAL", "ACCEPTED", "REJECTED", "ACTIVE", "TERMINATED"] },
        "requestedAt": { "type": "string" },
        "startedAt": { "type": "string" },
        "endedAt": { "type": "string" },
        "rejectionReason": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "deviceId", "adminId", "streamType", "status", "requestedAt"]
    },
    "SignalingMessage": {
      "title": "SignalingMessage",
      "description": "WebRTC SDP Offer, SDP Answer, or ICE Candidate",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["OFFER", "ANSWER", "ICE_CANDIDATE", "TERMINATE"] },
        "sdp": { "type": "string", "maxLength": 65536 },
        "candidate": { "type": "string", "maxLength": 4096 },
        "sdpMid": { "type": "string", "maxLength": 64 },
        "sdpMLineIndex": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sessionId", "senderId", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles for admins and device owners"
    },
    "/devices/{deviceId}": {
      "schema": "Device",
      "description": "Enrolled remote Android devices"
    },
    "/pairingRequests/{pairingId}": {
      "schema": "PairingRequest",
      "description": "Temporary QR and PIN code pairing authorizations"
    },
    "/sessions/{sessionId}": {
      "schema": "StreamSession",
      "description": "WebRTC media streaming sessions with explicit approvals"
    },
    "/sessions/{sessionId}/signaling/{signalId}": {
      "schema": "SignalingMessage",
      "description": "WebRTC signaling messages exchange"
    }
  }
}
